@using CleanArchitecture.Web.Models.ManagerDashboard
@model CleanArchitecture.Web.Models.ManagerDashboard.ManagerDashboardViewModel

@{
    ViewData["Title"] = "Manager Dashboard";

    var managerName = string.IsNullOrWhiteSpace(User.Identity?.Name)
        ? "Manager"
        : User.Identity.Name;

    var totalEmployees = Math.Max(Model.TotalEmployees, 0);
    var activeEmployees = Math.Max(Model.ActiveEmployees, 0);
    var inactiveEmployees = Math.Max(Model.InactiveEmployees, 0);

    var activePercentage = totalEmployees > 0
        ? Math.Min(activeEmployees * 100.0 / totalEmployees, 100)
        : 0;

    var inactivePercentage = totalEmployees > 0
        ? Math.Min(inactiveEmployees * 100.0 / totalEmployees, 100)
        : 0;

    var activeWidth = activePercentage.ToString(
        "0.##",
        System.Globalization.CultureInfo.InvariantCulture);

    var inactiveWidth = inactivePercentage.ToString(
        "0.##",
        System.Globalization.CultureInfo.InvariantCulture);

    var recentEmployees = Model.RecentEmployees ?? new List<ManagerEmployeeDto>();
}

<div class="manager-dashboard">

    <!-- Welcome Header -->
    <div class="dashboard-welcome">
        <div class="welcome-content">
            <span class="welcome-label">
                <i class="bi bi-grid-1x2-fill"></i>
                TEAM OVERVIEW
            </span>

            <h3>Welcome back, @managerName</h3>

            <p>
                Monitor your team, manage employees,
                and oversee daily operations.
            </p>
        </div>

        <div class="welcome-date">
            <i class="bi bi-calendar3"></i>
            <span>@DateTime.Now.ToString("dd MMM yyyy")</span>
        </div>
    </div>

    <!-- Statistics -->
    <div class="admin-stat-grid">

        <div class="admin-stat-card">
            <div class="stat-icon purple">
                <i class="bi bi-people-fill"></i>
            </div>

            <div class="stat-details">
                <span>Total Employees</span>
                <h3>@Model.TotalEmployees.ToString("N0")</h3>
                <small>Team members</small>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="stat-icon green">
                <i class="bi bi-person-check-fill"></i>
            </div>

            <div class="stat-details">
                <span>Active Employees</span>
                <h3>@Model.ActiveEmployees.ToString("N0")</h3>
                <small>Active team members</small>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="stat-icon orange">
                <i class="bi bi-person-x-fill"></i>
            </div>

            <div class="stat-details">
                <span>Inactive Employees</span>
                <h3>@Model.InactiveEmployees.ToString("N0")</h3>
                <small>Inactive accounts</small>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-person-heart"></i>
            </div>

            <div class="stat-details">
                <span>Total Customers</span>
                <h3>@Model.TotalCustomers.ToString("N0")</h3>
                <small>Registered customers</small>
            </div>
        </div>

    </div>

    <!-- Main Dashboard -->
    <div class="admin-dashboard-grid mt-4">

        <!-- Quick Actions -->
        <div class="admin-panel">

            <div class="panel-header">
                <div>
                    <h5>Quick Actions</h5>
                    <p>Frequently used team management tools</p>
                </div>

                <i class="bi bi-lightning-charge-fill panel-header-icon"></i>
            </div>

            <div class="quick-action-grid">

                <a asp-controller="Employee"
                   asp-action="Index"
                   class="quick-action">
                    <i class="bi bi-people-fill"></i>
                    <span>Employees</span>
                    <small>View and manage employees</small>
                </a>

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="quick-action">
                    <i class="bi bi-person-heart"></i>
                    <span>Customers</span>
                    <small>View customer accounts</small>
                </a>

                <a asp-controller="Account"
                   asp-action="Profile"
                   class="quick-action">
                    <i class="bi bi-person-circle"></i>
                    <span>My Profile</span>
                    <small>Manage your profile</small>
                </a>

                <a asp-controller="Home"
                   asp-action="Privacy"
                   class="quick-action">
                    <i class="bi bi-shield-lock"></i>
                    <span>Privacy</span>
                    <small>View privacy information</small>
                </a>

            </div>
        </div>

        <!-- Team Overview -->
        <div class="admin-panel">

            <div class="panel-header">
                <div>
                    <h5>Team Overview</h5>
                    <p>Employee account status</p>
                </div>

                <i class="bi bi-diagram-3-fill panel-header-icon"></i>
            </div>

            <div class="role-distribution">

                <!-- Active Employees -->
                <div class="role-stat-item">

                    <div class="role-stat-heading">
                        <span>
                            <i class="bi bi-circle-fill status-dot active-dot"></i>
                            Active Employees
                        </span>

                        <strong>
                            @activeEmployees.ToString("N0")
                            <small>(@activePercentage.ToString("0.##")%)</small>
                        </strong>
                    </div>

                    <div class="role-progress">
                        <div class="role-progress-bar"
                             style="width: @activeWidth%">
                        </div>
                    </div>

                </div>

                <!-- Inactive Employees -->
                <div class="role-stat-item">

                    <div class="role-stat-heading">
                        <span>
                            <i class="bi bi-circle-fill status-dot inactive-dot"></i>
                            Inactive Employees
                        </span>

                        <strong>
                            @inactiveEmployees.ToString("N0")
                            <small>(@inactivePercentage.ToString("0.##")%)</small>
                        </strong>
                    </div>

                    <div class="role-progress">
                        <div class="role-progress-bar inactive-progress"
                             style="width: @inactiveWidth%">
                        </div>
                    </div>

                </div>

                <div class="team-summary">
                    <div>
                        <span>Total Team Members</span>
                        <strong>@totalEmployees.ToString("N0")</strong>
                    </div>

                    <div>
                        <span>Active Rate</span>
                        <strong>@activePercentage.ToString("0.##")%</strong>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- Recent Employees -->
    <div class="admin-panel admin-table-panel mt-4">

        <div class="panel-header">
            <div>
                <h5>Recent Employees</h5>
                <p>Recently registered team members</p>
            </div>

            <a asp-controller="Employee"
               asp-action="Index"
               class="panel-action-link">
                View All
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="table-responsive">

            <table class="table admin-table align-middle">

                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Registered</th>
                    </tr>
                </thead>

                <tbody>

                    @if (recentEmployees.Count > 0)
                    {
                        foreach (var employee in recentEmployees)
                        {
                            var fullName = string.IsNullOrWhiteSpace(employee.FullName)
                            ? "Employee"
                            : employee.FullName.Trim();

                            var initial = fullName.Substring(0, 1).ToUpperInvariant();

                            <tr>
                                <td>
                                    <div class="table-user">
                                        <div class="table-avatar">
                                            @initial
                                        </div>

                                        <strong>@fullName</strong>
                                    </div>
                                </td>

                                <td>
                                    <span class="employee-email">
                                        @employee.Email
                                    </span>
                                </td>

                                <td>
                                    <span class="role-badge">
                                        @employee.Role
                                    </span>
                                </td>

                                <td>
                                    @if (employee.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-x-circle-fill"></i>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="registration-date">
                                        @employee.CreatedAt.ToString("dd MMM yyyy")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="dashboard-empty-state">
                                    <i class="bi bi-people"></i>
                                    <strong>No employees found</strong>
                                    <span>There are no recent employees to display.</span>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>