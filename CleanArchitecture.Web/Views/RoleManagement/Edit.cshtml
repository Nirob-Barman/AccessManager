@model CleanArchitecture.Web.Models.RoleManagement.EditRoleViewModel

@{
    ViewData["Title"] = "Edit Role";
}

<div class="container mt-4">

    <div class="mb-4">
        <h3>
            <i class="bi bi-pencil-square me-2"></i>
            Edit Role
        </h3>

        <p class="text-muted">
            Update the role information.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">
            <h6 class="mb-0">Role Information</h6>
        </div>

        <div class="card-body">

            <form asp-action="Edit"
                  asp-controller="RoleManagement"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label fw-bold">
                        Role Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter role name"
                           autocomplete="off" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>

                    Changing a role name does not change its assigned
                    permissions. Existing users will retain their
                    role membership through ASP.NET Core Identity.
                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>
                        Update Role
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
