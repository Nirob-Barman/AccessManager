@model List<CleanArchitecture.Web.Models.RoleManagement.RoleManagementViewModel>

@{
    ViewData["Title"] = "Role Management";
}

<div class="container mt-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="mb-1">
                <i class="bi bi-shield-lock me-2"></i>
                Role Management
            </h3>
            <p class="text-muted mb-0">
                Create, manage and assign roles to users.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i>
            Create New Role
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Total Roles</div>
                    <h3 class="mb-0">@Model.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Assigned Users</div>
                    <h3 class="mb-0">
                        @Model.Sum(r => r.UserCount)
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Custom Roles</div>
                    <h3 class="mb-0">
                        @Model.Count(r =>
                        r.Name != "SuperAdmin" &&
                        r.Name != "SystemAdmin")
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">
            <h6 class="mb-0">
                <i class="bi bi-list-ul me-2"></i>
                Available Roles
            </h6>
        </div>

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Role Name</th>
                                <th>Assigned Users</th>
                                <th>Role Type</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var index = 1;
                            }

                            @foreach (var role in Model)
                            {
                                var protectedRole =
                                role.Name == "SuperAdmin" ||
                                role.Name == "SystemAdmin";

                                <tr>
                                    <td>@index</td>

                                    <td>
                                        <i class="bi bi-shield-check me-2 text-primary"></i>
                                        <strong>@role.Name</strong>
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @role.UserCount Users
                                        </span>
                                    </td>

                                    <td>
                                        @if (protectedRole)
                                        {
                                            <span class="badge bg-secondary">
                                                System Role
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Custom Role
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <div class="d-flex justify-content-end gap-2">

                                            @if (!protectedRole)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@role.Id"
                                                   class="btn btn-sm btn-outline-primary"
                                                   title="Edit Role">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>

                                                <a asp-action="AssignUsers"
                                                   asp-route-roleId="@role.Id"
                                                   class="btn btn-sm btn-outline-success"
                                                   title="Assign Users">
                                                    <i class="bi bi-people"></i>
                                                </a>

                                                <form asp-action="Delete"
                                                      asp-route-id="@role.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to delete this role?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Delete Role">
                                                        <i class="bi bi-trash"></i>
                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">
                                                    Protected
                                                </span>
                                            }

                                        </div>

                                    </td>
                                </tr>

                                index++;
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-shield-x fs-1 text-muted"></i>
                    <p class="text-muted mt-2">
                        No roles found.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-success">
                        Create First Role
                    </a>
                </div>
            }

        </div>
    </div>

</div>