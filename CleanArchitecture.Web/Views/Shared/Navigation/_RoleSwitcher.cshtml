@using CleanArchitecture.Application.Constants
@using CleanArchitecture.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager

@if (User.Identity?.IsAuthenticated == true)
{
    var currentUser = await UserManager.GetUserAsync(User);

    if (currentUser != null)
    {
        var originalRoles = await UserManager.GetRolesAsync(currentUser);

        var isSuperAdmin = originalRoles.Contains(RoleConstants.SuperAdmin);
        var isSystemAdmin = originalRoles.Contains(RoleConstants.SystemAdmin);
        var isAdmin = User.IsInRole(RoleConstants.Admin);
        var isManager = User.IsInRole(RoleConstants.Manager);

        var activeRole = User.FindFirst("ActiveRole")?.Value
            ?? RoleConstants.SuperAdmin;

        <div class="role-switcher">

            <!-- Impersonation Dropdown -->
            @if (isSuperAdmin || isAdmin || isManager)
            {
                <div class="dropdown">

                    <button class="btn btn-sm btn-primary dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown">

                        <i class="bi bi-person-fill-check me-1"></i>
                        Login As

                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">

                        @if (isSuperAdmin || isSystemAdmin)
                        {
                            <li>
                                <form asp-controller="Auth"
                                      asp-action="ImpersonateAdmin"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="dropdown-item">

                                        <i class="bi bi-shield-check me-2"></i>
                                        Admin

                                    </button>

                                </form>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li>
                                <form asp-controller="Auth"
                                      asp-action="ImpersonateManager"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="dropdown-item">

                                        <i class="bi bi-person-badge me-2"></i>
                                        Manager

                                    </button>

                                </form>
                            </li>
                        }

                        @if (isAdmin || isManager)
                        {
                            <li>
                                <form asp-controller="Auth"
                                      asp-action="ImpersonateEmployee"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="dropdown-item">

                                        <i class="bi bi-people me-2"></i>
                                        Employee

                                    </button>

                                </form>
                            </li>

                            <li>
                                <form asp-controller="Auth"
                                      asp-action="ImpersonateCustomer"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="dropdown-item">

                                        <i class="bi bi-person me-2"></i>
                                        Customer

                                    </button>

                                </form>
                            </li>
                        }

                    </ul>

                </div>
            }

            <!-- Active Role Switcher -->
            @if (isSuperAdmin && !User.HasClaim("IsImpersonating", "true"))
            {
                <form asp-controller="Auth"
                      asp-action="SwitchRole"
                      method="post"
                      class="role-switch-form">

                    @Html.AntiForgeryToken()

                    <select name="role"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">

                        <option value="@RoleConstants.SuperAdmin"
                                selected="@(activeRole == RoleConstants.SuperAdmin)">
                            Super Admin
                        </option>

                        <option value="@RoleConstants.Admin"
                                selected="@(activeRole == RoleConstants.Admin)">
                            Admin
                        </option>

                        <option value="@RoleConstants.Manager"
                                selected="@(activeRole == RoleConstants.Manager)">
                            Manager
                        </option>

                        <option value="@RoleConstants.Employee"
                                selected="@(activeRole == RoleConstants.Employee)">
                            Employee
                        </option>

                        <option value="@RoleConstants.Customer"
                                selected="@(activeRole == RoleConstants.Customer)">
                            Customer
                        </option>

                    </select>

                </form>
            }

        </div>
    }
}