@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-page">

    <section class="privacy-hero">

        <div class="privacy-container">

            <span class="privacy-badge">
                <i class="bi bi-shield-lock-fill"></i>
                PRIVACY & SECURITY
            </span>

            <h1>
                Your Privacy Matters to
                <span>AccessManager</span>
            </h1>

            <p>
                We are committed to protecting your information
                and maintaining the security and confidentiality
                of your data.
            </p>

            <div class="privacy-updated">
                <i class="bi bi-calendar3"></i>
                Last updated: November 2026
            </div>

        </div>

    </section>

    <section class="privacy-content">

        <div class="privacy-container">

            <div class="privacy-intro">

                <div class="privacy-section-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>

                <h2>Privacy Policy</h2>

                <p>
                    This Privacy Policy explains how AccessManager
                    handles information when you use our application.
                    It describes our approach to data protection,
                    access management, and account security.
                </p>

            </div>

            <div class="privacy-card">

                <div class="privacy-card-icon">
                    <i class="bi bi-person-lock"></i>
                </div>

                <h4>1. Information We Collect</h4>

                <p>
                    AccessManager may process information necessary
                    to provide application functionality, including:
                </p>

                <ul>
                    <li>User account information and identity details.</li>
                    <li>Email addresses and authentication information.</li>
                    <li>User roles and access permissions.</li>
                    <li>Application activity and relevant audit information.</li>
                </ul>

            </div>

            <div class="privacy-card">

                <div class="privacy-card-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <h4>2. How We Use Information</h4>

                <p>
                    Information processed by AccessManager may be used to:
                </p>

                <ul>
                    <li>Authenticate and manage user accounts.</li>
                    <li>Enforce role-based access control.</li>
                    <li>Manage application permissions.</li>
                    <li>Maintain application security and reliability.</li>
                    <li>Support administrative operations.</li>
                </ul>

            </div>

            <div class="privacy-card">

                <div class="privacy-card-icon">
                    <i class="bi bi-key"></i>
                </div>

                <h4>3. Data Security</h4>

                <p>
                    AccessManager is designed to support secure
                    authentication and authorization through
                    role-based access control and permission management.
                </p>

                <p>
                    Appropriate security measures should be maintained
                    to help protect information against unauthorized
                    access, alteration, or disclosure.
                </p>

            </div>

            <div class="privacy-card">

                <div class="privacy-card-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h4>4. User Access and Responsibilities</h4>

                <p>
                    Users are responsible for protecting their
                    account credentials and using the application
                    according to their assigned access permissions.
                </p>

                <p>
                    Administrators are responsible for managing
                    user access and permissions appropriately.
                </p>

            </div>

            <div class="privacy-card">

                <div class="privacy-card-icon">
                    <i class="bi bi-database-check"></i>
                </div>

                <h4>5. Data Retention</h4>

                <p>
                    Information should be retained only as long as
                    necessary for legitimate application, operational,
                    security, and legal requirements.
                </p>

            </div>

            <div class="privacy-card">

                <div class="privacy-card-icon">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <h4>6. Policy Updates</h4>

                <p>
                    This Privacy Policy may be updated periodically
                    to reflect changes in application functionality,
                    security practices, or applicable requirements.
                </p>

            </div>

            <div class="privacy-contact">

                <div>
                    <i class="bi bi-question-circle-fill"></i>
                </div>

                <section>
                    <h4>Questions About Privacy?</h4>

                    <p>
                        If you have questions about this Privacy Policy
                        or how information is handled, please contact
                        your application administrator.
                    </p>
                </section>

            </div>

        </div>

    </section>

</div>
