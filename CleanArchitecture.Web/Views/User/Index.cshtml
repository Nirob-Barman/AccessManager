@model List<PermissionControl.Controllers.UserDummy>

@{
    ViewData["Title"] = "User Management";

    var permissions = Context.Items["UserPermissions"]
        as HashSet<string>
        ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
}

<div class="user-management-page">

    <!-- Page Header -->
    <div class="user-page-header">

        <div>
            <span class="user-page-subtitle">USER ADMINISTRATION</span>
            <h3>User Management</h3>
            <p>Manage user accounts, access, and account status.</p>
        </div>

        <div class="user-page-actions">

            @if (permissions.Contains("Users.List.Export"))
            {
                <a asp-action="Export"
                   class="btn btn-outline-success">

                    <i class="bi bi-download me-1"></i>
                    Export

                </a>
            }

            @if (permissions.Contains("Users.List.Create"))
            {
                <a asp-controller="User"
                   asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-circle me-1"></i>
                    Create User

                </a>
            }

        </div>

    </div>

    <!-- Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- User Table -->
    <div class="user-content-card">

        <div class="user-content-header">

            <div>
                <h5>
                    <i class="bi bi-people-fill me-2"></i>
                    User List
                </h5>

                <p>View and manage registered users.</p>
            </div>

            <span class="user-count">
                @Model.Count Users
            </span>

        </div>

        <div class="table-responsive">

            <table class="table user-management-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th class="user-actions-column">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr>

                                <td>
                                    <span class="user-id">#@user.Id</span>
                                </td>

                                <td>
                                    <div class="user-name-cell">
                                        <div class="user-avatar">
                                            <i class="bi bi-person-fill"></i>
                                        </div>

                                        <strong>@user.Name</strong>
                                    </div>
                                </td>

                                <td>@user.Email</td>

                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="user-status active">
                                            <span></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="user-status inactive">
                                            <span></span>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="user-action-buttons">

                                        @if (permissions.Contains("Users.List.Edit"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@user.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit User">

                                                <i class="bi bi-pencil-square"></i>
                                                Edit

                                            </a>
                                        }

                                        @if (permissions.Contains("Users.List.ResetPassword"))
                                        {
                                            <form asp-action="ResetPassword"
                                                  asp-route-id="@user.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning">

                                                    <i class="bi bi-key"></i>
                                                    Reset Password

                                                </button>

                                            </form>
                                        }

                                        @if (user.IsActive)
                                        {
                                            @if (permissions.Contains("Users.List.Deactivate"))
                                            {
                                                <form asp-action="Deactivate"
                                                      asp-route-id="@user.Id"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-secondary">

                                                        <i class="bi bi-person-x"></i>
                                                        Deactivate

                                                    </button>

                                                </form>
                                            }
                                        }
                                        else
                                        {
                                            @if (permissions.Contains("Users.List.Activate"))
                                            {
                                                <form asp-action="Activate"
                                                      asp-route-id="@user.Id"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">

                                                        <i class="bi bi-person-check"></i>
                                                        Activate

                                                    </button>

                                                </form>
                                            }
                                        }

                                        @if (permissions.Contains("Users.List.Delete"))
                                        {
                                            <form asp-action="Delete"
                                                  asp-route-id="@user.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Delete this user?')">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">

                                                    <i class="bi bi-trash"></i>
                                                    Delete

                                                </button>

                                            </form>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="user-empty-state">

                                    <i class="bi bi-people"></i>

                                    <h6>No Users Found</h6>

                                    <p>There are currently no users to display.</p>

                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
